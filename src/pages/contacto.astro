---
import Layout from "../layouts/Layout.astro";
import SectionContainer from "../components/SectionContainer.astro";
import FormContact from "../components/FormContact.astro";
import SocialNetworks from "../components/SocialNetworks.astro";
---

<Layout title="Casmaq">
  <main>
    <SectionContainer class="pt-10 font-sans">
      <div class="flex flex-col md:flex-row mx-4">
        <div class="md:w-3/3">
          <!-- Contact Section with Social Links -->
          <section class="bg-teal-700 py-8 px-6 rounded-3xl">
            <div
              class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-8"
            >
              <FormContact />

              <SocialNetworks />
            </div>
          </section>
        </div>
      </div>
    </SectionContainer>
  </main>
</Layout>
